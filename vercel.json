{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": ".",
  "functions": {
    "api/feed.mjs": {
      "maxDuration": 30
    },
    "api/ingest.mjs": {
      "maxDuration": 240
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/stopped.html",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/stopped.html",
      "permanent": false
    },
    {
      "source": "/api/:path*",
      "destination": "/stopped.html",
      "permanent": false
    }
  ]
}
